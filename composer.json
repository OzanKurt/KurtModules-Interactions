{
  "name": "ozankurt/laravel-modules-interactions",
  "description": "Polymorphic social & engagement toolkit for Laravel: emoji reactions, comments, @mentions, likes/votes/ratings/favorites/subscriptions, and a follows/friendships social graph. Headless + optional Filament admin.",
  "keywords": ["laravel", "filament", "kurtmodules", "social", "reactions", "comments", "mentions", "follow", "friendship"],
  "license": "MIT",
  "authors": [{ "name": "Ozan Kurt", "email": "ozankurt2@gmail.com" }],
  "require": {
    "php": "^8.4",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "league/commonmark": "^2.4",
    "ozankurt/laravel-modules-core": "^2.0",
    "spatie/laravel-package-tools": "^1.93"
  },
  "require-dev": {
    "filament/filament": "^3.0 || ^4.0 || ^5.0",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": { "Kurt\\Modules\\Interactions\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": {
      "Kurt\\Modules\\Interactions\\Tests\\": "tests/",
      "Database\\Factories\\Kurt\\Modules\\Interactions\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Kurt\\Modules\\Interactions\\Providers\\InteractionsServiceProvider"]
    }
  },
  "repositories": [
    { "type": "vcs", "url": "https://github.com/OzanKurt/laravel-modules-core" }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/pint --test",
    "format": "vendor/bin/pint",
    "stan": "vendor/bin/phpstan analyse --memory-limit=2G"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
